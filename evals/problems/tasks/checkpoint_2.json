[
  {
    "name": "sort-by-priority",
    "group": "core",
    "steps": [
      { "args": ["add", "low", "--priority", "1"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["add", "high", "--priority", "5"], "exitCode": 0, "stdout": "added 2" },
      { "args": ["add", "mid", "--priority", "3"], "exitCode": 0, "stdout": "added 3" },
      { "args": ["list"], "exitCode": 0, "stdout": "2 [open] high\n3 [open] mid\n1 [open] low" }
    ]
  },
  {
    "name": "priority-then-id",
    "group": "core",
    "steps": [
      { "args": ["add", "a", "--priority", "2"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["add", "b", "--priority", "2"], "exitCode": 0, "stdout": "added 2" },
      { "args": ["list"], "exitCode": 0, "stdout": "1 [open] a\n2 [open] b" }
    ]
  },
  {
    "name": "list-json",
    "group": "core",
    "steps": [
      { "args": ["add", "x", "--tag", "work", "--priority", "2"], "exitCode": 0, "stdout": "added 1" },
      {
        "args": ["list", "--json"],
        "exitCode": 0,
        "json": [{ "id": 1, "title": "x", "status": "open", "priority": 2, "tags": ["work"] }]
      }
    ]
  },
  {
    "name": "list-tag-filter",
    "group": "core",
    "steps": [
      { "args": ["add", "a", "--tag", "home"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["add", "b", "--tag", "work"], "exitCode": 0, "stdout": "added 2" },
      { "args": ["list", "--tag", "work"], "exitCode": 0, "stdout": "2 [open] b" }
    ]
  },
  {
    "name": "tag-filter-none",
    "group": "core",
    "steps": [
      { "args": ["add", "a", "--tag", "home"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["list", "--tag", "work"], "exitCode": 0, "stdout": "0 tasks" }
    ]
  },
  {
    "name": "default-priority-zero",
    "group": "functionality",
    "steps": [
      { "args": ["add", "plain"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["add", "high", "--priority", "1"], "exitCode": 0, "stdout": "added 2" },
      { "args": ["list"], "exitCode": 0, "stdout": "2 [open] high\n1 [open] plain" }
    ]
  },
  {
    "name": "duplicate-tags-dropped",
    "group": "functionality",
    "steps": [
      { "args": ["add", "x", "--tag", "a", "--tag", "b", "--tag", "a"], "exitCode": 0, "stdout": "added 1" },
      {
        "args": ["list", "--json"],
        "exitCode": 0,
        "json": [{ "id": 1, "title": "x", "status": "open", "priority": 0, "tags": ["a", "b"] }]
      }
    ]
  },
  {
    "name": "json-and-tag",
    "group": "functionality",
    "steps": [
      { "args": ["add", "a", "--tag", "x"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["add", "b", "--tag", "y"], "exitCode": 0, "stdout": "added 2" },
      {
        "args": ["list", "--json", "--tag", "y"],
        "exitCode": 0,
        "json": [{ "id": 2, "title": "b", "status": "open", "priority": 0, "tags": ["y"] }]
      }
    ]
  },
  {
    "name": "seeded-missing-priority",
    "group": "functionality",
    "files": {
      "tasks.json": "{\"tasks\":[{\"id\":1,\"title\":\"old\",\"status\":\"open\"}]}"
    },
    "steps": [
      { "args": ["add", "new", "--priority", "1"], "exitCode": 0, "stdout": "added 2" },
      { "args": ["list"], "exitCode": 0, "stdout": "2 [open] new\n1 [open] old" }
    ]
  },
  {
    "name": "flags-before-title",
    "group": "functionality",
    "steps": [
      { "args": ["add", "--priority", "4", "--tag", "k", "hello"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["list"], "exitCode": 0, "stdout": "1 [open] hello" }
    ]
  },
  {
    "name": "negative-priority",
    "group": "functionality",
    "steps": [
      { "args": ["add", "n", "--priority", "-2"], "exitCode": 0, "stdout": "added 1" },
      { "args": ["add", "z"], "exitCode": 0, "stdout": "added 2" },
      { "args": ["list"], "exitCode": 0, "stdout": "2 [open] z\n1 [open] n" }
    ]
  },
  {
    "name": "empty-tag-rejected",
    "group": "error",
    "steps": [{ "args": ["add", "x", "--tag"], "exitCode": 1, "stdout": "" }]
  },
  {
    "name": "bad-priority",
    "group": "error",
    "steps": [{ "args": ["add", "x", "--priority", "nope"], "exitCode": 1, "stdout": "" }]
