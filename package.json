{
  "name": "ai-lint-rules",
  "private": true,
  "type": "module",
  "description": "Copy-paste Oxlint rules, strict TypeScript, and oracle tests for React Compiler apps.",
  "scripts": {
    "test": "vitest run --config oxlint/react-bans/vitest.config.ts && vitest run --config oracles/vitest.config.ts",
    "typecheck": "tsc -p oracles && tsc -p evals"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "4.7.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "31.0.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^7.0.2007",
    "supercluster": "^9.1.0",
    "typescript": "^7.0.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.34.4"
